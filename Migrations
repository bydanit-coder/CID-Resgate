-- ===== 13. POLICIES (drop + create para idempotência) =====
drop policy if exists profiles_leitura on public.profiles;
drop policy if exists profiles_insert on public.profiles;
drop policy if exists profiles_update_cordas on public.profiles;
drop policy if exists profiles_update_chefe on public.profiles;
create policy profiles_leitura on public.profiles for select to authenticated using (true);
create policy profiles_insert on public.profiles for insert to authenticated
  with check (public.is_cordas());
create policy profiles_update_cordas on public.profiles for update to authenticated
  using (public.is_cordas()) with check (public.is_cordas());
create policy profiles_update_chefe on public.profiles for update to authenticated
  using ((public.is_chefe_turno() or public.is_gestor()) and turno_id = public.my_turno_id())
  with check ((public.is_chefe_turno() or public.is_gestor()) and turno_id = public.my_turno_id());

drop policy if exists registos_leitura on public.registos;
drop policy if exists registos_insert on public.registos;
drop policy if exists registos_update_cordas on public.registos;
drop policy if exists registos_delete on public.registos;
create policy registos_leitura on public.registos for select to authenticated using (true);
create policy registos_insert on public.registos for insert to authenticated with check (
  user_id = auth.uid() or public.is_cordas()
  or ((public.is_chefe_turno() or public.is_gestor())
      and exists (select 1 from public.profiles t where t.id = user_id and t.turno_id = public.my_turno_id())));
create policy registos_update_cordas on public.registos for update to authenticated
  using (public.is_cordas()) with check (public.is_cordas());
create policy registos_delete on public.registos for delete to authenticated using (
  public.is_cordas()
  or ((public.is_chefe_turno() or public.is_gestor())
      and exists (select 1 from public.profiles t where t.id = user_id and t.turno_id = public.my_turno_id())));

drop policy if exists manobras_leitura on public.manobras;
drop policy if exists manobras_escrita_cordas on public.manobras;
create policy manobras_leitura on public.manobras for select to authenticated using (true);
create policy manobras_escrita_cordas on public.manobras for all to authenticated
  using (public.is_cordas()) with check (public.is_cordas());

drop policy if exists t_sel_anon on public.turnos;
drop policy if exists t_sel_auth on public.turnos;
create policy t_sel_anon on public.turnos for select to anon using (true);
create policy t_sel_auth on public.turnos for select to authenticated using (true);

drop policy if exists auditoria_leitura_cordas on public.auditoria;
create policy auditoria_leitura_cordas on public.auditoria for select to authenticated
  using (public.is_cordas());

drop policy if exists om_leitura on public.operacional_manobra;
create policy om_leitura on public.operacional_manobra for select to authenticated using (true);

drop policy if exists te_leitura on public.teleferico_externos;
create policy te_leitura on public.teleferico_externos for select to authenticated using (true);

drop policy if exists "Histórico: leitura" on public.cursos_historico;
drop policy if exists "Histórico: escrita (chefe_cordas)" on public.cursos_historico;
create policy "Histórico: leitura" on public.cursos_historico
  for select using (
    auth.role() = 'authenticated'
    and (auth.uid() = user_id
         or exists (select 1 from public.profiles where id = auth.uid() and role = 'chefe_cordas'))
  );
create policy "Histórico: escrita (chefe_cordas)" on public.cursos_historico
  for all using (
    auth.role() = 'authenticated'
    and exists (select 1 from public.profiles where id = auth.uid() and role = 'chefe_cordas')
  );

