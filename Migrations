  for each row execute function public.fn_auditar();

create trigger trg_guard_profiles before update on public.profiles
  for each row execute function public.fn_guard_profiles();
create trigger trg_guard_profiles_insert before insert on public.profiles
  for each row execute function public.fn_guard_profiles_insert();
