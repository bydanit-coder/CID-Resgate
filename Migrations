-- =====================================================
-- RSB — Resgate por Cordas · Migração completa
-- Ficheiro único: estrutura + segurança + seed
-- =====================================================

-- ===== 1. TABELAS =====
create table if not exists public.turnos (
  id serial primary key,
  nome text not null,
  cor text
);

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  numero_operacional text,
  nome text,
  email text,
  role text not null default 'operacional',
  turno_id integer references public.turnos(id),
  ativo boolean not null default true,
  so_teleferico boolean not null default false,
  tele_posicao integer,
  curso_ra date,
  curso_ru date,
  curso_rt date,
  criada_em timestamptz not null default now(),
  quartel text,
  turno_origem text,
  veio_cid boolean not null default false,
  gestor boolean not null default false
);

create table if not exists public.manobras (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  ativo boolean not null default true,
  especial boolean not null default false
);

create table if not exists public.operacional_manobra (
  user_id uuid not null references public.profiles(id) on delete cascade,
  manobra_id uuid not null references public.manobras(id) on delete cascade,
  ativo boolean not null default true,
  atribuido_por uuid,
  primary key (user_id, manobra_id)
);

create table if not exists public.registos (
  id bigserial primary key,
  user_id uuid not null references public.profiles(id) on delete cascade,
  manobra_id uuid not null references public.manobras(id) on delete cascade,
  realizado_em date not null,
  posicao integer,
  criado_por uuid default auth.uid(),
  criado_em timestamptz not null default now()
);

create table if not exists public.auditoria (
  id bigserial primary key,
  tabela text not null,
  operacao text not null,
  dados_antigos jsonb,
  dados_novos jsonb,
  user_id uuid,
  user_numero text,
  registo_id text,
  criado_em timestamptz not null default now()
);

create table if not exists public.teleferico_externos (
  id uuid primary key default gen_random_uuid(),
  numero_operacional text not null,
  nome text,
  quartel text,
  turno_origem text,
  cid_turno integer references public.turnos(id),
  curso_rt date,
  curso_ru date,
  curso_ra date,
  veio_cid boolean not null default false,
  ativo boolean not null default true,
  criada_em timestamptz not null default now()
);

create table if not exists public.cursos_historico (
  id bigserial primary key,
  user_id uuid not null references public.profiles(id) on delete cascade,
  tipo text not null check (tipo in ('ra', 'ru', 'rt')),
  data date not null,
  criado_em timestamptz not null default now(),
  criado_por uuid references auth.users(id),
  nota text
);

-- ===== 2. VIEW =====
create or replace view public.v_ultimo_registo as
select user_id, manobra_id, max(realizado_em) as realizado_em
from public.registos
group by user_id, manobra_id;

-- ===== 3. CONSTRAINTS =====
alter table public.registos drop constraint if exists registos_uniq;
alter table public.registos add constraint registos_uniq
  unique nulls not distinct (user_id, manobra_id, realizado_em, posicao);

-- ===== 4. ÍNDICES =====
create index if not exists cursos_hist_user_tipo
  on public.cursos_historico (user_id, tipo, data desc);

-- ===== 5. HELPERS (security definer = leem profiles por cima do RLS) =====
create or replace function public.is_cordas()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.profiles where id = auth.uid() and role = 'chefe_cordas' and ativo <> false);
$$;

create or replace function public.is_chefe_turno()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.profiles where id = auth.uid() and role = 'chefe_turno' and ativo <> false);
$$;

create or replace function public.is_gestor()
returns boolean language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.profiles where id = auth.uid() and gestor = true and ativo <> false);
$$;

create or replace function public.my_turno_id()
returns integer language sql stable security definer set search_path = public as $$
  select turno_id from public.profiles where id = auth.uid();
$$;

create or replace function public.fn_curso_ativo(t text, uid uuid)
returns date language sql stable as $$
  select data from public.cursos_historico where user_id = uid and tipo = t order by data desc limit 1;
$$;

-- ===== 6. FUNÇÕES DE NEGÓCIO =====
create or replace function public.fn_numero_disponivel(p_numero text)
returns boolean language sql stable security definer set search_path = public as $$
  select not exists (select 1 from public.profiles where ativo = true and numero_operacional = p_numero);
$$;

create or replace function public.fn_normalizar_chefia_turno(v_turno integer)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not (public.is_cordas() or public.is_chefe_turno() or public.is_gestor()) then
    raise exception 'Sem permissão.';
  end if;
  if not exists (select 1 from public.profiles where turno_id = v_turno and ativo = true and role = 'chefe_turno')
     and exists (select 1 from public.profiles where turno_id = v_turno and ativo = true and role = 'operacional') then
    update public.profiles set role = 'chefe_turno'
    where id = (select id from public.profiles
                where turno_id = v_turno and ativo = true and role = 'operacional'
                order by numero_operacional::int asc nulls last limit 1);
  end if;
end; $$;

-- ===== 7. AUDITORIA (trigger que regista tudo) =====
create or replace function public.fn_auditar()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_old jsonb; v_new jsonb; v_id text; v_uid uuid;
  v_num text; v_claims text; v_mname text; v_pname text;
begin
  begin v_uid := auth.uid(); exception when others then v_uid := null; end;
  if v_uid is null then
    begin
      v_claims := current_setting('request.jwt.claims', true);
      if v_claims is not null and v_claims <> '' then
        v_uid := (v_claims::jsonb ->> 'sub')::uuid;
      end if;
    exception when others then null; end;
  end if;

  if v_uid is not null then
    select coalesce(p.numero_operacional, p.nome, replace(split_part(p.email,'@',1),'.',' '))
      into v_num from public.profiles p where p.id = v_uid;
  end if;

  if tg_op = 'INSERT' then
    v_old := null; v_new := to_jsonb(new); v_id := coalesce(new.id::text,'');
  elsif tg_op = 'UPDATE' then
    v_old := to_jsonb(old); v_new := to_jsonb(new); v_id := coalesce(new.id::text, old.id::text,'');
  elsif tg_op = 'DELETE' then
    v_old := to_jsonb(old); v_new := null; v_id := coalesce(old.id::text,'');
  end if;

  if tg_table_name = 'registos' then
    select m.nome into v_mname from public.manobras m
     where m.id = case when tg_op = 'DELETE' then (v_old->>'manobra_id')::uuid
                       else (v_new->>'manobra_id')::uuid end;
    select coalesce(p.numero_operacional, p.nome, replace(split_part(p.email,'@',1),'.',' '))
      into v_pname from public.profiles p
     where p.id = case when tg_op = 'DELETE' then (v_old->>'user_id')::uuid
                       else (v_new->>'user_id')::uuid end;
    if v_old is not null then
      v_old := v_old || jsonb_build_object('_manobra', coalesce(v_mname,'—'), '_pessoa', coalesce(v_pname,'—'));
    end if;
    if v_new is not null then
      v_new := v_new || jsonb_build_object('_manobra', coalesce(v_mname,'—'), '_pessoa', coalesce(v_pname,'—'));
    end if;
  end if;

  insert into auditoria (tabela, operacao, registo_id, dados_antigos, dados_novos, user_id, user_numero)
  values (tg_table_name, tg_op, v_id, v_old, v_new, v_uid, v_num);

  return case tg_op when 'DELETE' then old else new end;
end; $$;

-- ===== 8. CURSOS (histórico + sync) =====
create or replace function public.fn_add_curso(p_uid uuid, p_tipo text, p_data date, p_nota text default null)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not public.is_cordas() then raise exception 'Apenas o Chefe das Cordas pode gerir cursos.'; end if;
  insert into public.cursos_historico (user_id, tipo, data, criado_por, nota)
  values (p_uid, p_tipo, p_data, auth.uid(), p_nota);
end; $$;

create or replace function public.fn_del_curso(p_uid uuid, p_tipo text)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not public.is_cordas() then raise exception 'Apenas o Chefe das Cordas pode gerir cursos.'; end if;
  delete from public.cursos_historico
  where id = (select id from public.cursos_historico where user_id = p_uid and tipo = p_tipo order by data desc limit 1);
  update public.profiles
  set curso_ra = fn_curso_ativo('ra', p_uid), curso_ru = fn_curso_ativo('ru', p_uid), curso_rt = fn_curso_ativo('rt', p_uid)
  where id = p_uid;
end; $$;

create or replace function public.fn_sync_curso_ativo()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  if new.data is null then
    execute format('update public.profiles set curso_%I = null where id = %L', new.tipo, new.user_id);
  else
    execute format('update public.profiles set curso_%I = %L where id = %L', new.tipo, new.data, new.user_id);
  end if;
  return new;
end; $$;

-- ===== 9. GUARDS (blindagem de segurança) =====
create or replace function public.fn_guard_profiles()
returns trigger language plpgsql security definer set search_path = public as $$
declare v_role text; v_turno integer; v_gestor boolean;
begin
  if auth.uid() is null then return new; end if;
  select role, turno_id, gestor into v_role, v_turno, v_gestor from public.profiles where id = auth.uid();
  if v_role = 'chefe_cordas' then return new; end if;
  if v_role = 'chefe_turno' or coalesce(v_gestor, false) then
    if old.turno_id is distinct from v_turno then raise exception 'Sem permissão sobre este turno.'; end if;
    if old.ativo = false and new.ativo = true then raise exception 'Só o Chefe das Cordas pode reativar um perfil.'; end if;
    if (new.role is distinct from old.role) or (new.numero_operacional is distinct from old.numero_operacional)
       or (new.turno_id is distinct from old.turno_id) or (new.curso_ra is distinct from old.curso_ra)
       or (new.curso_ru is distinct from old.curso_ru) or (new.curso_rt is distinct from old.curso_rt)
       or (new.quartel is distinct from old.quartel) or (new.email is distinct from old.email) then
      raise exception 'Sem permissão para alterar estes campos.';
    end if;
    return new;
  end if;
  raise exception 'Sem permissão.';
end; $$;

create or replace function public.fn_guard_profiles_insert()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  if auth.uid() is null then return new; end if;
  if new.email is not null and new.email !~* '@cm-lisboa\.pt$' then
    raise exception 'Só são aceites e-mails @cm-lisboa.pt.';
  end if;
  if public.is_cordas() then return new; end if;
  new.role := 'operacional'; new.gestor := false; new.ativo := true;
  new.curso_ra := null; new.curso_ru := null; new.curso_rt := null;
  new.so_teleferico := false;
  return new;
end; $$;

create or replace function public.fn_guard_registos()
returns trigger language plpgsql security definer set search_path = public as $$
declare v_especial boolean;
begin
  if auth.uid() is null then return new; end if;
  if new.realizado_em > current_date then raise exception 'A data do registo não pode ser futura.'; end if;
  select coalesce(especial, false) into v_especial from public.manobras where id = new.manobra_id;
  if v_especial then
    if not exists (select 1 from public.profiles where id = new.user_id and curso_rt is not null) then
      raise exception 'Só operacionais com curso RT podem registar o teleférico.';
    end if;
    if new.posicao is null or new.posicao not in (1,2,3,4) then
      raise exception 'Posição inválida (1, 2, 3/T ou 4/VE).';
    end if;
  else
    if exists (select 1 from public.profiles where id = new.user_id and coalesce(so_teleferico,false) = true) then
      raise exception 'Operacional "só teleférico" não regista esta manobra.';
    end if;
    new.posicao := null;
  end if;
  return new;
end; $$;

-- ===== 10. TRANSFERIR CHEFIA =====
create or replace function public.transferir_gestao_v2(p_email text, p_nome text, p_novo_id uuid default null)
returns void language plpgsql security definer set search_path = public as $$
declare v_alvo public.profiles%rowtype;
begin
  if not exists (select 1 from public.profiles where id = auth.uid() and role = 'chefe_cordas' and ativo = true) then
    raise exception 'Sem permissão.';
  end if;
  if p_novo_id is not null then
    insert into public.profiles (id, nome, email, role, ativo, numero_operacional, turno_id)
    values (p_novo_id, p_nome, p_email, 'chefe_cordas', true, null, null)
    on conflict (id) do update set nome = excluded.nome, email = excluded.email, role = 'chefe_cordas',
      ativo = true, numero_operacional = null, turno_id = null;
  else
    select * into v_alvo from public.profiles where lower(email) = lower(p_email);
    if not found then raise exception 'Esse e-mail ainda não tem conta.'; end if;
    if v_alvo.numero_operacional is not null then raise exception 'Só podes transferir para quem não tem número operacional.'; end if;
    update public.profiles set role = 'chefe_cordas', ativo = true, numero_operacional = null, turno_id = null, nome = p_nome
    where id = v_alvo.id;
  end if;
  update public.profiles set ativo = false where id = auth.uid();
end; $$;

