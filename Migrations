create trigger tr_aud_profiles after insert or update or delete on public.profiles
  for each row execute function public.fn_auditar();
create trigger tr_aud_registos after insert or update or delete on public.registos
  for each row execute function public.fn_auditar();
create trigger tr_aud_manobras after insert or update or delete on public.manobras
  for each row execute function public.fn_auditar();
create trigger tr_aud_turnos after insert or update or delete on public.turnos
  for each row execute function public.fn_auditar();
